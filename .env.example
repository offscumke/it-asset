COMPOSE_PROJECT_NAME=it-asset
APP_BIND=0.0.0.0
APP_PORT=3001
IMAGE_TAG=latest

ADMIN_USER=admin
ADMIN_PASS=change-me-use-a-long-password
AGENT_SECRET=change-me-generate-a-random-agent-secret
JWT_SECRET=change-me-generate-a-random-jwt-secret

# Set this to the externally reachable URL, for example https://assets.example.com.
PUBLIC_BASE_URL=
TRUST_PROXY=0
CORS_ORIGIN=
PING_INTERVAL_SECONDS=60
